# Port fuer den Custom-Server (Next.js + WebSocket auf einem Port)
PORT=3000

# Node-Umgebung
NODE_ENV=development

# Optional: Render Deploy Hook fuer automatisches Deployment aus CI
# RENDER_DEPLOY_HOOK_URL=

# Optional: Render API Key, nur fuer automatisiertes Setup durch das Deploy-Tooling
# RENDER_API_KEY=

# Passwort fuer das "Bald verfuegbar"-Gate (siehe middleware.ts / lib/gate.ts).
# Ohne diese Variable gilt der Default "lars". Kein echtes Sicherheitssystem,
# nur eine Reibungsbremse gegen zufaellige Besucher vor dem oeffentlichen Start.
# GATE_PASSWORD=lars
