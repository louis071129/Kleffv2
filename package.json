{
  "name": "klaeff",
  "version": "0.1.0",
  "private": true,
  "description": "KLAEFF - Multiplayer Bell-Wettkampf im Browser",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w packages/scoring && npm run typecheck -w packages/protocol && npm run typecheck -w packages/bark-synth",
    "pretest": "npm run gen-fixtures",
    "test": "vitest run",
    "test:watch": "npm run gen-fixtures && vitest",
    "test:e2e": "npm run gen-fixtures && playwright test",
    "start:dev-e2e": "tsx server/index.ts",
    "gen-fixtures": "tsx scripts/gen-fixtures.ts",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@klaeff/bark-synth": "*",
    "@klaeff/protocol": "*",
    "@klaeff/scoring": "*",
    "framer-motion": "^11.15.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
